%----------------------------------------------------------------------

% Rules 1: Check the judge qualification
% For checking the judge qualification on evaluate project based on matching ExpertiseCategory

judgeQualify(JudgeID, ProjectID) :-
    judge(JudgeID, Category),
    project(ProjectID, Category, _).
    
% Rules 2: Check the project assigned
% For checking project assigned in specific booth based on categories

projectAssigned(ProjectID, BoothNumber) :-
    project(ProjectID, Category, _),
    booth(BoothNumber, Category).

% Rules 3: Conflict Resolution
% To ensure there is no judge assigned to evaluate if there is conflict or interest
conflictInterest('J001', 'P001').

judgeAccess(JudgeID, ProjectID) :-
    judgeQualify(JudgeID, ProjectID),
    \+ conflictInterest(JudgeID, ProjectID).
    
% Rules 4: Award Eligibility
% To define the predicate rule to identify project (If Innovation Score >85, eligible category accessed)

awardEligibility(ProjectID, InnovationScore) :-
    project(ProjectID, _, InnovationScore),
    InnovationScore > 85,
    projectAssigned(ProjectID, _).
    
%----------------------------------------------------------------------

main :-
    write('-----------------------------------------'),
    write('\nInnovation Day Showcase Management System'),
    write('\n-----------------------------------------'),
    write('\n'),
    write('\nList of Project:'),
    nl,
    show_projects,

    write('\nJudge Qualification:'),
    nl,
    judge_qualify,

    write('\nProject Assigned:'),
    nl,
    assigned_project,

    write('\nJudge Accessibilty:'),
    nl,
    access_judge,
    
    write('\nAward Eligibility:'),
    nl,
    award_eligible.

show_projects :-
    project(ProjectID, Category, Score),
    format('\nProject ID: ~w~nCategories: ~w~nScore: ~w\n', [ProjectID, Category, Score]),
    fail.
show_projects.

judge_qualify :-
    forall(
        judgeQualify(JudgeID, ProjectID),
        format('Match Found -> Judge: ~w | Project: ~w~n', [JudgeID, ProjectID])
    ).

assigned_project :-
    forall(
        projectAssigned(ProjectID, BoothNumber),
        format('Project Assigned -> Project: ~w | Booth Number: ~w~n', [ProjectID, BoothNumber])
    ).

access_judge :-
    forall(
        (judgeQualify(JudgeID, ProjectID), \+ conflictInterest(JudgeID, ProjectID)),
        format('Judge Access -> Judge: ~w | Project: ~w~n', [JudgeID, ProjectID])
    ).

award_eligible :-
    forall(
        awardEligibility(ProjectID, InnovationScore),
        format('Best Innovation Award: ~w | Innovation Score: ~w~n', [ProjectID, InnovationScore])
    ).
