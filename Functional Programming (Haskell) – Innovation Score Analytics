module Main where

import Data.List (maximumBy)
import Data.Ord (comparing)

-- 1. Custom Data Type definition for a Project
data Project = Project
    { projectId :: String
    , category  :: String
    , scores    :: [Double]
    } deriving (Show, Eq)

-- 2. Pure Functions for Data Analytics

-- Function 1: Calculate aggregate average score using foldl (Pure Function & Higher-Order Function)
avgScore :: Project -> Double
avgScore p
    | null (scores p) = 0.0
    | otherwise       = totalScore / count
  where
    totalScore = foldl (+) 0.0 (scores p)
    count      = fromIntegral (length (scores p))

-- Function 2: Filter projects qualifying for Final Pitching Round (Threshold >= 80)
filterFinalists :: Double -> [Project] -> [Project]
filterFinalists threshold = filter (\p -> avgScore p >= threshold)

-- Function 3: Find overall winning project with the highest average score
findWinner :: [Project] -> Maybe Project
findWinner [] = Nothing
findWinner ps = Just $ maximumBy (comparing avgScore) ps


-- ====================================================================
-- SAMPLE DATA & TEST EXECUTION
-- ====================================================================

-- Sample dataset matching Part A categories
sampleProjects :: [Project]
sampleProjects =
    [ Project "P001" "Fiction"   [88.0, 92.0, 90.0] -- Avg: 90.0
    , Project "P002" "Science"   [80.0, 85.0, 87.0] -- Avg: 84.0
    , Project "P003" "Science"   [91.0, 89.0, 90.0] -- Avg: 90.0
    , Project "P004" "Biography" [92.0, 90.0, 91.0] -- Avg: 91.0 (Winner)
    , Project "P005" "Cooking"   [85.0, 87.0, 86.0] -- Avg: 86.0
    , Project "P006" "Society"   [84.0, 86.0, 85.0] -- Avg: 85.0
    , Project "P007" "Education" [75.0, 80.0, 79.0] -- Avg: 78.0
    , Project "P008" "Fiction"   [82.0, 85.0, 85.0] -- Avg: 84.0
    ]

main :: IO ()
main = do
    putStrLn "==============================================="
    putStrLn "   INNOVATION DAY SHOWCASE - HASKELL ANALYTICS "
    putStrLn "==============================================="
    
    putStrLn "\n--- 1. AGGREGATED AVERAGE SCORES ---"
    mapM_ (\p -> putStrLn $ "Project ID: " ++ projectId p ++ 
                            " | Category: " ++ category p ++ 
                            " | Average Score: " ++ show (avgScore p)) sampleProjects

    putStrLn "\n--- 2. QUALIFIED FOR FINAL PITCHING ROUND (Avg >= 80) ---"
    let finalists = filterFinalists 80.0 sampleProjects
    mapM_ (\p -> putStrLn $ "Finalist: " ++ projectId p ++ 
                            " | Category: " ++ category p ++ 
                            " | Score: " ++ show (avgScore p)) finalists

    putStrLn "\n--- 3. OVERALL SHOWCASE WINNER ---"
    case findWinner sampleProjects of
        Just winner -> putStrLn $ "Winner: " ++ projectId winner ++ 
                                  " (" ++ category winner ++ ")" ++
                                  " with Average Score: " ++ show (avgScore winner)
        Nothing     -> putStrLn "No projects available."
